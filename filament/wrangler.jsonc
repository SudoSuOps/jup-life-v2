{
  // filament.juplifestudio.com: separate Pages project, root directory "filament"
  "name": "jup-filament",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    // database_id: paste the id from Workers & Pages > D1 > jup-filament
    { "binding": "DB", "database_name": "jup-filament", "database_id": "REPLACE_WITH_D1_DATABASE_ID" }
  ]
}
