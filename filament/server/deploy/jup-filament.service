[Unit]
Description=JUP LIFE filament shelf (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
User=jupfilament
Group=jupfilament
EnvironmentFile=/etc/jup-filament.env
WorkingDirectory=/opt/jup-life-v2/filament/server
ExecStart=/opt/jup-filament-venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8790 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-server-header
Restart=on-failure
RestartSec=3
# hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/jup-filament
StateDirectory=jup-filament

[Install]
WantedBy=multi-user.target
