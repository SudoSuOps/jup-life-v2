# /etc/jup-filament.env  (chmod 600, owned by root)
FILAMENT_DB=/var/lib/jup-filament/filament.db
FILAMENT_BACKUP_DIR=/var/backups/jup-filament

# Cloudflare Access: Zero Trust > Access > Applications > JUP Filament
ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
ACCESS_AUD=paste-the-application-audience-tag

# For printers/scripts on this rig: curl -H "Authorization: Bearer $API_TOKEN" http://127.0.0.1:8790/api/...
API_TOKEN=generated-by-install.sh

# Optional: daily "what to order" post. Mattermost > Integrations > Incoming Webhooks
MATTERMOST_WEBHOOK_URL=
FILAMENT_PUBLIC_URL=https://filament.juplifestudio.com
