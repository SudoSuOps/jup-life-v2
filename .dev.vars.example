# Copy to .dev.vars for local `wrangler pages dev`. Never commit .dev.vars.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Ignored for checkout. The Hibiscus Set uses STRIPE_PRICE_HIBISCUS_SET.
STRIPE_PRICE_SIX_SET_CASE=price_xxx
STRIPE_PRICE_FALL_POP_COASTERS=price_xxx
STRIPE_PRICE_GIGI=price_xxx
STRIPE_PRICE_TIDE_SOAP_DISH=price_xxx
STRIPE_PRICE_TIDE_DISPENSER=price_xxx
# Readers ($21). Leave unset until a $21 Stripe price exists. STRIPE_PRICE_READERS is ignored.
STRIPE_PRICE_READER_21=
# Pop Coasters 6-Pack at $29 (Flat or Edge). Leave blank to show Coming soon.
# Do not paste the Half Dozen or Baker's Dozen price ID here.
STRIPE_PRICE_POP_COASTERS_6=
# The Hibiscus Set at $39. Leave unset to fall back to STRIPE_PRICE_FLOWER_SET_CASE.
STRIPE_PRICE_HIBISCUS_SET=
# Flower Coaster Set with Case at $39 (Sunflower). Hibiscus on that card checks out as six-set-case.
STRIPE_PRICE_FLOWER_SET_CASE=
RESEND_API_KEY=
